@{ ViewData["Title"]="Dashboard"; var top=(IEnumerable<Student>)ViewBag.TopStudents; var recent=(IEnumerable<Student>)ViewBag.Recent; var stats=ViewBag.CourseStats as IEnumerable<dynamic>; }
<section class="hero"><div><span class="pill">● SYSTEM ONLINE</span><h2>Good day, Administrator.</h2><p>Here’s what’s happening across your student records.</p></div><a class="btn btn-light" asp-controller="Students" asp-action="ExportCsv">↓ Export records</a></section>
<div class="stat-grid"><div class="stat-card"><span class="stat-icon blue">◎</span><small>Total Students</small><strong>@ViewBag.Total</strong><span class="trend">All registered records</span></div><div class="stat-card"><span class="stat-icon green">✓</span><small>Active Students</small><strong>@ViewBag.Active</strong><span class="trend">@ViewBag.Inactive inactive</span></div><div class="stat-card"><span class="stat-icon purple">★</span><small>Average CGPA</small><strong>@ViewBag.Average</strong><span class="trend">Out of 10.0</span></div><div class="stat-card"><span class="stat-icon orange">◫</span><small>Courses</small><strong>@ViewBag.Courses</strong><span class="trend">Across departments</span></div></div>
<div class="grid-2"><section class="panel"><div class="panel-head"><div><h3>Top performers</h3><p>Highest CGPA in the system</p></div><a asp-controller="Students" asp-action="Index">View all →</a></div><div class="performers">@foreach(var s in top){<div class="performer"><div class="avatar">@s.FullName.Substring(0,1)</div><div class="grow"><b>@s.FullName</b><small>@s.StudentId · @s.Course</small></div><span class="score">@s.CGPA.ToString("0.00")</span></div>}</div></section><section class="panel"><div class="panel-head"><div><h3>Course distribution</h3><p>Students by programme</p></div></div><div class="bars">@foreach(var x in (dynamic)ViewBag.CourseStats){ var max=(int)ViewBag.Total; <div class="bar-row"><div><span>@x.Name</span><b>@x.Count</b></div><div class="bar"><i style="width:@(max==0?0:(x.Count*100/max))%"></i></div></div>}</div></section></div>
<section class="panel"><div class="panel-head"><div><h3>Recent enrollments</h3><p>Latest student records</p></div><a asp-controller="Students" asp-action="Create">+ Add student</a></div><div class="table-wrap"><table><thead><tr><th>Student</th><th>ID</th><th>Course</th><th>Semester</th><th>CGPA</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var s in recent){<tr><td><div class="student-cell"><div class="avatar">@s.FullName.Substring(0,1)</div><b>@s.FullName</b></div></td><td>@s.StudentId</td><td>@s.Course</td><td>Sem @s.Semester</td><td><b>@s.CGPA.ToString("0.00")</b></td><td><span class="badge @(s.IsActive?"success":"muted")">@(s.IsActive?"Active":"Inactive")</span></td><td><a class="more" asp-controller="Students" asp-action="Details" asp-route-id="@s.Id">View</a></td></tr>}</tbody></table></div></section>
