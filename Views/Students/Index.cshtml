@model IEnumerable<Student>
@{ ViewData["Title"]="Students"; }
<section class="page-intro"><div><span class="eyebrow">DIRECTORY</span><h2>Student records</h2><p>Search, filter and manage every student from one place.</p></div><div class="intro-actions"><a class="btn btn-secondary" asp-action="ExportCsv">↓ Export CSV</a><a class="btn btn-primary" asp-action="Create">＋ Add student</a></div></section>
<form class="filters" method="get"><input name="search" value="@ViewBag.Search" placeholder="Search name, roll number or email…"/><select name="course"><option value="">All courses</option>@foreach(var c in (IEnumerable<string>)ViewBag.Courses){<option selected="@(ViewBag.Course==c)" value="@c">@c</option>}</select><select name="semester"><option value="">All semesters</option>@for(int i=1;i<=8;i++){<option selected="@(ViewBag.Semester==i)" value="@i">Semester @i</option>}</select><select name="active"><option value="">Any status</option><option selected="@(ViewBag.Active==true)" value="true">Active</option><option selected="@(ViewBag.Active==false)" value="false">Inactive</option></select><button class="btn btn-secondary" type="submit">Filter</button><a class="clear" asp-action="Index">Clear</a></form>
<section class="panel"><div class="table-meta"><span><b>@Model.Count()</b> students found</span></div><div class="table-wrap"><table><thead><tr><th>Student</th><th>Roll Number</th><th>Course</th><th>Semester</th><th>CGPA</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var s in Model){<tr><td><div class="student-cell"><div class="avatar">@s.FullName.Substring(0,1)</div><div><b>@s.FullName</b><small>@s.Email</small></div></div></td><td><code>@s.StudentId</code></td><td>@s.Course</td><td>Sem @s.Semester</td><td><span class="cgpa">@s.CGPA.ToString("0.00")</span></td><td><span class="badge @(s.IsActive?"success":"muted")">@(s.IsActive?"Active":"Inactive")</span></td><td><div class="actions"><a title="View" asp-action="Details" asp-route-id="@s.Id">↗</a><a title="Edit" asp-action="Edit" asp-route-id="@s.Id">✎</a><form asp-action="ToggleStatus" asp-route-id="@s.Id" method="post"><button title="Toggle status">◐</button></form><form asp-action="Delete" asp-route-id="@s.Id" method="post" onsubmit="return confirm('Delete this student permanently?')"><button class="danger" title="Delete">⌫</button></form></div></td></tr>} @if(!Model.Any()){<tr><td colspan="7"><div class="empty small"><div class="empty-icon">⌕</div><h3>No students found</h3><p>Try changing your filters or add a new student.</p></div></td></tr>}</tbody></table></div></section>
