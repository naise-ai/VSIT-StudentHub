@model Student
@{ ViewData["Title"]="Student Profile"; }<section class="profile-head"><div class="profile-avatar">@Model.FullName.Substring(0,1)</div><div class="grow"><span class="eyebrow">STUDENT PROFILE</span><h2>@Model.FullName</h2><p>@Model.StudentId · @Model.Course</p></div><div class="intro-actions"><a class="btn btn-secondary" asp-action="Edit" asp-route-id="@Model.Id">✎ Edit</a><a class="btn btn-primary" asp-action="Index">← Directory</a></div></section><div class="profile-grid"><section class="panel"><div class="panel-head"><div><h3>Academic overview</h3><p>Current academic standing</p></div></div><div class="profile-stats"><div><small>CGPA</small><strong>@Model.CGPA.ToString("0.00")</strong></div><div><small>Semester</small><strong>@Model.Semester</strong></div><div><small>Status</small><strong>@(Model.IsActive?"Active":"Inactive")</strong></div></div><div class="detail-list"><div><span>Course</span><b>@Model.Course</b></div><div><span>Enrollment date</span><b>@Model.EnrollmentDate.ToString("dd MMM yyyy")</b></div><div><span>Date of birth</span><b>@Model.DateOfBirth.ToString("dd MMM yyyy")</b></div></div></section><section class="panel"><div class="panel-head"><div><h3>Contact details</h3><p>Student communication information</p></div></div><div class="detail-list"><div><span>Email</span><b>@Model.Email</b></div><div><span>Phone</span><b>@(string.IsNullOrWhiteSpace(Model.Phone)?"Not provided":Model.Phone)</b></div><div><span>Roll Number</span><b><code>@Model.StudentId</code></b></div></div></section></div>
