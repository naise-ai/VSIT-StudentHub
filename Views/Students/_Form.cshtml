@model Student
<div class="form-section"><div><h3>Identity</h3><p>Basic student information</p></div><div class="form-grid"><label>Student ID<input asp-for="StudentId" placeholder="VSIT2026001"/><span asp-validation-for="StudentId" class="field-error"></span></label><label>Full name<input asp-for="FullName" placeholder="Enter full name"/><span asp-validation-for="FullName" class="field-error"></span></label><label>Email address<input asp-for="Email" placeholder="student@example.com"/><span asp-validation-for="Email" class="field-error"></span></label><label>Phone number<input asp-for="Phone" placeholder="+91 98765 43210"/><span asp-validation-for="Phone" class="field-error"></span></label></div></div><div class="form-section"><div><h3>Academic</h3><p>Programme and performance</p></div><div class="form-grid"><label>Course<select asp-for="Course"><option>B.Sc. Information Technology</option><option>BCA</option><option>B.Sc. Computer Science</option><option>B.Com</option><option>B.Sc. Data Science</option></select></label><label>Semester<select asp-for="Semester">@for(int i=1;i<=8;i++){<option value="@i">Semester @i</option>}</select></label><label>CGPA<input asp-for="CGPA" type="number" step="0.01" min="0" max="10" placeholder="8.50"/></label><label>Status<select asp-for="IsActive"><option value="true">Active</option><option value="false">Inactive</option></select></label></div></div><div class="form-section"><div><h3>Dates</h3><p>Enrollment and personal timeline</p></div><div class="form-grid"><label>Date of birth<input asp-for="DateOfBirth" type="date"/></label><label>Enrollment date<input asp-for="EnrollmentDate" type="date"/></label></div></div>
