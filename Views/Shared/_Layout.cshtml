<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] · VSIT StudentHub</title><link rel="stylesheet" href="~/css/site.css"/></head><body>
@if (User.Identity?.IsAuthenticated == true) { <div class="app-shell"><aside class="sidebar"><div class="brand"><span class="brand-mark">S</span><div><b><span class="vsit-name">VSIT</span> StudentHub</b><small>Management Suite</small></div></div><nav><a asp-controller="Dashboard" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString()=="Dashboard"?"active":"")"><span>⌂</span> Dashboard</a><a asp-controller="Students" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString()=="Students"?"active":"")"><span>◉</span> Students</a><a asp-controller="Students" asp-action="Create"><span>＋</span> Add Student</a></nav><div class="side-footer"><div class="mini-avatar">A</div><div><b>Administrator</b><small>VSIT Admin</small></div><form asp-controller="Account" asp-action="Logout" method="post"><button class="icon-btn" title="Logout">↪</button></form></div></aside><main class="main"><header class="topbar"><div><span class="eyebrow">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</span><h1>@ViewData["Title"]</h1></div><div class="top-actions"><a class="btn btn-primary" asp-controller="Students" asp-action="Create">＋ New Student</a></div></header><div class="content">@if (TempData["Success"] != null){<div class="toast">✓ @TempData["Success"]</div>} @RenderBody()</div></main></div> } else { @RenderBody() }<script src="~/js/site.js"></script>@await RenderSectionAsync("Scripts", required:false)</body></html>
